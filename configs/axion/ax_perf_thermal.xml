<?xml version="1.0" encoding="utf-8"?>
<!--
    ax_perf_thermal.xml — MT6789
    CPU: 6x Cortex-A55 (little) @ 400–2000 MHz
         2x Cortex-A76 (big)   @ 400–2200 MHz
    GPU: Mali-G57 MP2          @ up to 1000 MHz
    Target: Balance performa & baterai
-->
<perf-config>
    <atmc>
        <!-- ═══════════════════════════════════════════════
             CPU LEVELS  — 27 steps
             Format: little="min,max"  big="min,max"  (MHz)
             Level 1  = full performance
             Level 27 = maximum power saving
        ═══════════════════════════════════════════════ -->
        <cpu_levels>
            <level id="1"  little="480,2000" big="400,2200"/>
            <level id="2"  little="480,1942" big="400,2138"/>
            <level id="3"  little="480,1883" big="400,2077"/>
            <level id="4"  little="480,1825" big="400,2015"/>
            <level id="5"  little="480,1766" big="400,1954"/>
            <level id="6"  little="480,1708" big="400,1892"/>
            <level id="7"  little="480,1649" big="400,1831"/>
            <level id="8"  little="480,1591" big="400,1769"/>
            <level id="9"  little="480,1532" big="400,1708"/>
            <level id="10" little="480,1474" big="400,1646"/>
            <level id="11" little="480,1415" big="400,1585"/>
            <level id="12" little="480,1357" big="400,1523"/>
            <level id="13" little="480,1298" big="400,1462"/>
            <level id="14" little="480,1240" big="400,1400"/>
            <level id="15" little="480,1182" big="400,1338"/>
            <level id="16" little="480,1123" big="400,1277"/>
            <level id="17" little="480,1065" big="400,1215"/>
            <level id="18" little="480,1006" big="400,1154"/>
            <level id="19" little="480,948"  big="400,1092"/>
            <level id="20" little="480,889"  big="400,1031"/>
            <level id="21" little="480,831"  big="400,969"/>
            <level id="22" little="480,772"  big="400,908"/>
            <level id="23" little="480,714"  big="400,846"/>
            <level id="24" little="480,655"  big="400,785"/>
            <level id="25" little="480,597"  big="400,677"/>
            <level id="26" little="480,538"  big="400,585"/>
            <level id="27" little="480,480"  big="400,400"/>
        </cpu_levels>

        <!-- ═══════════════════════════════════════════════
             GPU LEVELS — Mali-G57 MP2 (max ~1000 MHz)
             min = floor index, max = ceiling index (0–10)
        ═══════════════════════════════════════════════ -->
        <gpu_levels>
            <level id="1"  min="10" max="0"/>
            <level id="2"  min="10" max="1"/>
            <level id="3"  min="10" max="2"/>
            <level id="4"  min="10" max="3"/>
            <level id="5"  min="10" max="4"/>
            <level id="6"  min="10" max="5"/>
            <level id="7"  min="10" max="6"/>
            <level id="8"  min="10" max="7"/>
            <level id="9"  min="10" max="8"/>
            <level id="10" min="10" max="9"/>
            <level id="11" min="10" max="10"/>
        </gpu_levels>

        <!-- ═══════════════════════════════════════════════
             BOOST SCENARIOS
        ═══════════════════════════════════════════════ -->
        <boost_scenarios>
            <scenario id="1" name="ALL_BOOST"    params="1086324736,1"/>
            <scenario id="2" name="TOPAPP_BOOST" params="1086324736,2"/>
        </boost_scenarios>

        <!-- ═══════════════════════════════════════════════
             SCENES — tuning conteks sistem
        ═══════════════════════════════════════════════ -->
        <scenes>

            <!-- Default: balance, throttle is light when hot -->
            <scene name="default_scene">
                <level id="5">
                    <action unit="cpu" status="14"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="16"/>
                    <action unit="boost_scenario" status="2"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="18"/>
                    <action unit="dexopt" status="1"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="20"/>
                    <action unit="bg_killer" status="3"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="22"/>
                    <action unit="bg_killer" status="4"/>
                </level>
            </scene>

            <!-- Game: more performance, but doesn't drain the battery -->
            <scene name="game">
                <level id="5">
                    <action unit="cpu" status="9"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="11"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="13"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="18"/>
                </level>
                <level id="11">
                    <action unit="gpu" status="7"/>
                    <action unit="cpu" status="21"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="9"/>
                </level>
            </scene>

            <!-- Aggressive throttle when FGS is hot -->
            <scene name="heating_fgs">
                <level id="5">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="23"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="25"/>
                </level>
            </scene>

            <!-- Camera: responsive but economical, no need for full boost -->
            <scene name="axcamera_photo_preview">
                <level id="7">
                    <action unit="cpu" status="10"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="13"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="15"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="18"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="22"/>
                </level>
                <level id="12">
                    <action unit="cpu" status="24"/>
                </level>
            </scene>

        </scenes>

        <!-- ═══════════════════════════════════════════════
             APP-SPECIFIC TUNING
        ═══════════════════════════════════════════════ -->
        <apps>

            <!-- Benchmark: fully unlocked so that the score is accurate -->
            <app pkgs="com.antutu.ABenchMark,com.andromeda.androbench2,com.antutu.benchmark.full,com.primatelabs.geekbench5.corporate,com.primatelabs.geekbench5,com.primatelabs.geekbench4.corporate,com.primatelabs.geekbench6.corporate,com.primatelabs.geekbench6,net.kishonti.gfxbench.v50000.corporate">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="24"/>
                </level>
            </app>

            <!-- 3DMark: unlock GPU -->
            <app pkgs="com.futuremark.dmandroid.application">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="8"/>
                </level>
                <level id="14">
                    <action unit="gpu" status="10"/>
                </level>
            </app>

            <!-- CPU throttle test: let the throttle natural -->
            <app pkgs="skynet.cputhrottlingtest">
                <level id="12">
                    <action unit="cpu" status="20"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="22"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="25"/>
                </level>
            </app>

            <!-- Social & video call: latency priority, not throughput -->
            <app pkgs="com.instagram.android,com.facebook.mlite,com.whatsApp,com.google.android.apps.tachyon,com.snapchat.android,us.zoom.videomeetings,com.tencent.wemeet.app,com.ss.android.lark,com.microsoft.teams">
                <level id="4">
                    <action unit="cpu" status="15"/>
                </level>
                <level id="5">
                    <action unit="cpu" status="17"/>
                </level>
                <level id="6">
                    <action unit="cpu" status="19"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="21"/>
                </level>
            </app>

            <!-- Maps/Navigation: need consistency, don't need high burst -->
            <app pkgs="com.google.android.apps.maps,com.autonavi.minimap,com.waze,ru.yandex.yandexmaps,org.rajman.neshan.traffic.tehran.navigator,ru.dublgis.dgismobile,de.blitzer,com.baidu.BaiduMap">
                <level id="7">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="18"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="23"/>
                </level>
            </app>

            <!-- PUBG Mobile: balance, no need for max freq directly -->
            <app pkgs="com.pubg.imobile,com.tencent.ig,com.tencent.igfit">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="6"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="9"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="12"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="21"/>
                </level>
            </app>

            <!-- Genshin/Star Rail: GPU-heavy, throttles faster when hot -->
            <app pkgs="com.HoYoverse.hkrpgoversea,com.miHoYo.Yuanshen,com.miHoYo.GenshinImpact,com.netmarble.sololv">
                <level id="5">
                    <action unit="cpu" status="9"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="11"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="13"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="15"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="20"/>
                </level>
            </app>

        </apps>
    </atmc>
</perf-config>
